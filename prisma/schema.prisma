// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserRole {
  id        String     @id @default(uuid())
  roleName  String     @unique
  users     User[]
  permissions UserRolePermission[]
}

model Permission {
  id            String      @id @default(uuid())
  permissionName String     @unique
  roles         UserRolePermission[]
}

model UserRolePermission {
  id           String        @id @default(uuid())
  userRoleId   String
  permissionId String

  userRole     UserRole   @relation(fields: [userRoleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([userRoleId, permissionId], name: "userRole_permission_unique")
}

model User {
  id              String    @id @default(uuid())
  username        String    @unique
  email           String    @unique
  password        String
  phone_number    String?
  employee_number String    @unique
  role            UserRole  @relation(fields: [userRoleId], references: [id])
  userRoleId      String
  created_at      DateTime  @default(now())
  deleted_at      DateTime?
  updated_at      DateTime  @updatedAt @default(now())
  updated_by      String?
  
  reportsReceived Report[]  @relation("UserReportTo")
  reportsSent     Report[]  @relation("UserReportFrom")
  supervisedBy UserSupervisor[] @relation("SupervisorStaff")
  supervising UserSupervisor[] @relation("StaffSupervisors")
  
}

model UserSupervisor {
  id            String    @id @default (uuid())
  staffId       String
  supervisorId  String
  staff         User      @relation("StaffSupervisors", fields: [staffId], references: [id])
  supervisor    User      @relation("SupervisorStaff", fields: [supervisorId], references: [id])
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt @default(now())

  @@unique([staffId, supervisorId], name: "supervisor_staff_unique")
}


model Report {
  id String @id @default(uuid())
  reportToId String
  reportTo User @relation("UserReportTo", fields: [reportToId], references: [id])
  reportFromId String
  reportFrom User @relation("UserReportFrom", fields: [reportFromId], references: [id])
  reportCategoryId String
  reportCategory ReportCategory @relation(fields: [reportCategoryId], references: [id])
  report_description String @db.Text
  created_at DateTime @default(now())
  deleted_at DateTime?
  updated_at DateTime @updatedAt @default(now())
  updated_by String?
  report_image  String?
}

model ReportCategory {
  id String @id @default(uuid())
  category_name String @unique @db.VarChar(100)
  created_at DateTime @default(now())
  deleted_at DateTime?
  updated_at DateTime @updatedAt
  reports Report[]
}
