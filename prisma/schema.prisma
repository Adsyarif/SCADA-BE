
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserRole {
  id        String     @id @default(uuid())
  roleName  String     @unique
  created_at DateTime @default(now())
  deleted_at DateTime?
  updated_at DateTime @updatedAt @default(now())
  updated_by String?

  users     User[]
  userRolePermissions UserRolePermission[]
}

model Permission {
  id            String      @id @default(uuid())
  permissionCode String     @unique
  permissionName String

  userRolePermissions  UserRolePermission[]
}

model UserRolePermission {
  id           String        @id @default(uuid())
  userRoleId   String
  permissionId String

  userRole     UserRole   @relation(fields: [userRoleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([userRoleId, permissionId], name: "userRole_permission_unique")
}


model User {
  id              String    @id @default(uuid())
  username        String    @unique
  email           String    @unique
  password        String
  phone_number    String?
  office_phone_number String?
  employee_number String    @unique
  nik             String?    @unique
  address          String?
  userRoleId      String
  created_at      DateTime  @default(now())
  deleted_at      DateTime?
  updated_at      DateTime  @updatedAt @default(now())
  updated_by      String?
  
  reportsReceived Report[]  @relation("UserReportTo")
  reportsSent     Report[]  @relation("UserReportFrom")
  asStaffIn      UserSupervisor[] @relation("UserIsStaff")      
  asSupervisorIn UserSupervisor[] @relation("UserIsSupervisor")  
  attendances Attendance[] @relation("UserAttendance")
  role            UserRole  @relation(fields: [userRoleId], references: [id])
  userSites       UserSite[]
  reportReplies   ReportReply[] @relation("UserReportReplies")

}

model UserSupervisor {
   id           String    @id @default(uuid())
  staffId      String
  supervisorId String
  deleted_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt @default(now())

  staff        User      @relation("UserIsStaff", fields: [staffId], references: [id])
  supervisor   User      @relation("UserIsSupervisor", fields: [supervisorId], references: [id])

  @@unique([staffId, supervisorId], name: "supervisor_staff_unique")
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION
}
model Report {
  id                String          @id @default(uuid())
  reportToId        String
  reportTo          User            @relation("UserReportTo", fields: [reportToId], references: [id])
  reportFromId      String
  reportFrom        User            @relation("UserReportFrom", fields: [reportFromId], references: [id])
  reportCategoryId  String
  reportCategory    ReportCategory  @relation(fields: [reportCategoryId], references: [id])
  report_description String         @db.Text
  created_at        DateTime        @default(now())
  deleted_at        DateTime?
  updated_at        DateTime        @updatedAt @default(now())
  updated_by        String?
  report_image      String?
  status            ReportStatus    @default(PENDING)

  replies           ReportReply[]  
}

model ReportReply {
  id             String         @id @default(uuid())
  reportId       String
  userId         String
  parentReplyId  String?
  message        String         @db.Text
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  deleted_at     DateTime?

  report         Report         @relation(fields: [reportId], references: [id])
  user           User           @relation("UserReportReplies", fields: [userId], references: [id])

  parentReply    ReportReply?   @relation("ReplyThread", fields: [parentReplyId], references: [id])
  replies        ReportReply[]  @relation("ReplyThread")
}





model ReportCategory {
  id String @id @default(uuid())
  category_name String @unique @db.VarChar(100)
  created_at DateTime @default(now())
  deleted_at DateTime?
  updated_at DateTime @updatedAt
  reports Report[]
}

model Attendance {
  id String @id @default(uuid())
  staff_id String
   staff      User     @relation("UserAttendance", fields: [staff_id], references: [id])
  created_at DateTime @default(now())
  deleted_at DateTime?
  updated_at DateTime @updatedAt
}

model RtuConfiguration {
  id          String      @id @default(uuid())
  rtuEngineId String
  rtuName     String      @unique
  latitude    Float
  longitude   Float
  radius      Float
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt @default(now())
  deleted_at  DateTime?
  updated_by  String?
  
  userSites   UserSite[]
  scheduleDefinitions ScheduleDefinition[]
  spesification RTUSpecification[]
  logger  DataLogger[]

}

model UserSite {
  id         String           @id @default(uuid())
  userId     String
  rtuId      String
  checkInStatus Boolean      @default(false)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt @default(now())
  deleted_at DateTime?
  updated_by String?

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rtuConfiguration RtuConfiguration @relation(fields: [rtuId], references: [id], onDelete: Cascade)
  scheduleDefinitionUserSites ScheduleDefinitionUserSite[]

  @@unique([userId, rtuId], name: "user_site_unique")
}

model Shift {
  id          String      @id @default(uuid())
  shiftName   String      @unique
  startTime   DateTime
  endTime     DateTime
  isActive    Boolean     @default(true)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt @default(now())
  deleted_at  DateTime?
  updated_by  String?
  scheduleDefinitions ScheduleDefinition[]

}

model ScheduleDefinition {
  id          String   @id @default(cuid())
  rtu         RtuConfiguration @relation(fields: [rtuId], references: [id])
  rtuId       String
  shift       Shift    @relation(fields: [shiftId], references: [id])
  shiftId     String
  daysOfWeek  String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  deleted_at  DateTime?
  updated_by  String?

  userSites   ScheduleDefinitionUserSite[]

  @@unique([rtuId, shiftId, daysOfWeek])
}

model ScheduleDefinitionUserSite {
  id                     String              @id @default(cuid())
  scheduleDefinition     ScheduleDefinition  @relation(fields: [scheduleDefinitionId], references: [id])
  scheduleDefinitionId   String
  userSite               UserSite            @relation(fields: [userSiteId], references: [id])
  userSiteId             String
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt
  deleted_at             DateTime?
  updated_by             String?

  @@unique([scheduleDefinitionId, userSiteId])
}


model RTUSpecification {
  id String   @id @default(cuid())
  flowellCode String
  pumpType String
  tankCapacity Int
  plungerDiameter Int
  strokeLength Int
  maxSettingPress Int
  flowCapacity Int
  tankLevel Int
  RTUConfigId String
  RTUId String
  create_at DateTime
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt
  deleted_at             DateTime?
  RTU RtuConfiguration @relation(fields: [RTUId], references: [id])
}

enum RTUStatus {
 ON
 OFF
}
model DataLogger {
  id String   @id @default(cuid())
  created_at             DateTime            @default(now())
  tubingTemp Int
  tubingPress Int
  LEUStatus RTUStatus @default(OFF)
  settingPress Int
  pumpPress Int
  tankLevel Int
  flowCapacity Int
  RTUId String

  RTU RtuConfiguration @relation(fields: [RTUId], references: [id])
}