
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserRole {
  id        String     @id @default(uuid())
  roleName  String     @unique
  created_at DateTime @default(now())
  deleted_at DateTime?
  updated_at DateTime @updatedAt @default(now())
  updated_by String?

  users     User[]
  userRolePermissions UserRolePermission[]
}

model Permission {
  id            String      @id @default(uuid())
  permissionCode String     @unique
  permissionName String

  userRolePermissions  UserRolePermission[]
}

model UserRolePermission {
  id           String        @id @default(uuid())
  userRoleId   String
  permissionId String

  userRole     UserRole   @relation(fields: [userRoleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([userRoleId, permissionId], name: "userRole_permission_unique")
}


model User {
  id              String    @id @default(uuid())
  username        String    @unique
  email           String    @unique
  password        String
  phone_number    String?
  employee_number String    @unique
  userRoleId      String
  created_at      DateTime  @default(now())
  deleted_at      DateTime?
  updated_at      DateTime  @updatedAt @default(now())
  updated_by      String?
  
  reportsReceived Report[]  @relation("UserReportTo")
  reportsSent     Report[]  @relation("UserReportFrom")
  asStaffIn      UserSupervisor[] @relation("UserIsStaff")      
  asSupervisorIn UserSupervisor[] @relation("UserIsSupervisor")  
  attendances Attendance[] @relation("UserAttendance")

  role            UserRole  @relation(fields: [userRoleId], references: [id])
  userSites       UserSite[]
}

model UserSupervisor {
   id           String    @id @default(uuid())
  staffId      String
  supervisorId String
  deleted_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt @default(now())

  staff        User      @relation("UserIsStaff", fields: [staffId], references: [id])
  supervisor   User      @relation("UserIsSupervisor", fields: [supervisorId], references: [id])

  @@unique([staffId, supervisorId], name: "supervisor_staff_unique")
}


model Report {
  id String @id @default(uuid())
  reportToId String
  reportTo User @relation("UserReportTo", fields: [reportToId], references: [id])
  reportFromId String
  reportFrom User @relation("UserReportFrom", fields: [reportFromId], references: [id])
  reportCategoryId String
  reportCategory ReportCategory @relation(fields: [reportCategoryId], references: [id])
  report_description String @db.Text
  created_at DateTime @default(now())
  deleted_at DateTime?
  updated_at DateTime @updatedAt @default(now())
  updated_by String?
  report_image  String?
}


model ReportCategory {
  id String @id @default(uuid())
  category_name String @unique @db.VarChar(100)
  created_at DateTime @default(now())
  deleted_at DateTime?
  updated_at DateTime @updatedAt
  reports Report[]
}

model Attendance {
  id String @id @default(uuid())
  staff_id String
   staff      User     @relation("UserAttendance", fields: [staff_id], references: [id])
  created_at DateTime @default(now())
  deleted_at DateTime?
  updated_at DateTime @updatedAt
}

model RtuConfiguration {
  id          String      @id @default(uuid())
  rtuName     String      @unique
  latitude    Float
  longitude   Float
  radius      Float
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt @default(now())
  deleted_at  DateTime?
  updated_by  String?
  
  userSites   UserSite[]
}

model UserSite {
  id         String           @id @default(uuid())
  userId     String
  rtuId      String
  checkInStatus Boolean      @default(false)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt @default(now())
  deleted_at DateTime?
  updated_by String?

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rtuConfiguration RtuConfiguration @relation(fields: [rtuId], references: [id], onDelete: Cascade)

  @@unique([userId, rtuId], name: "user_site_unique")
}

